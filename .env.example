# The release site is read-only; retired browser-only workspaces are NOT released.
# All VITE_ variables are embedded in browser JavaScript: NEVER put secrets there.

# The SEPARATE invite-only adult/internal pilot requires a trusted API + PostgreSQL.
# Put these on your PRIVATE server/Railway service, not in VITE_ variables or Git:
# DATABASE_URL=<reference the private PostgreSQL service variable>
# APP_ORIGIN=https://no-public-origin.invalid # private shell-only deployment; no browser login
# Replace with the exact approved HTTPS host (no trailing slash) ONLY after private ingress review.
# NODE_ENV=production
# PILOT_ENABLED=false                       # enable only after adult draft approval
# PILOT_DRAFT_ACKNOWLEDGED=false            # explicitly set true for the internal draft
# ENGINE_V2_ENABLED=false                   # additive, unpublished draft-2 pilot; off by default
# ENGINE_DRAFT_ACKNOWLEDGED=false           # operator explicitly accepts unreviewed candidate
# CHILD_ACCOUNTS_ENABLED=false              # must stay false; there is NO minor enrolment
# GUARDIAN_EVIDENCE_COLLECTION_ENABLED=false # must stay false; there is NO consent capture
# MINOR_LEARNING_ENABLED=false              # must stay false; there is NO minor learning access
# RAILPACK_NODE_VERSION=22                  # Railway build setting
# PORT=<injected by Railway>
# DATABASE_TLS=verify                       # only with a trusted external TLS CA
# PILOT_OPERATOR=<name of authorised operator for restricted CLI commands>

# Local dev can use http://127.0.0.1:5173 as APP_ORIGIN and the Vite /api proxy.
# AI-01 gateway stays OFF in existing Railway IaC. These are SERVER-ONLY values; no VITE_ names.
# Review docs/AI_GATEWAY_RUNBOOK.md and provider terms before setting any of these.
# AI_GATEWAY_ENABLED=false                 # requires private adult pilot + reviewed migration 004
# AI_ADMIN_UI_ENABLED=false                # separately granted private reviewer only; no MFA yet
# AI_LIVE_TESTS_APPROVED=false             # named owner accepts actual provider call/cost
# AI_SCHEMA_MIGRATION_APPROVED=false       # only for manual ai-migrate after backup/review
# AI_ADMIN_GRANT_APPROVED=false            # only for trusted CLI membership grant
# AI_TIMEOUT_MS=8000                       # 1000–30000; server-enforced per request
# AI_RETRIES=1                             # 0–2; each retry reserves quota/cost
# AI_CACHE_HMAC_KEY=<store a random 32+ character secret in approved server secret store>
# GEMINI_API_KEY=<server-only; blocked by current under-18 API-client terms>
# GROQ_API_KEY=<server-only>
# OPENROUTER_API_KEY=<server-only; check upstream model terms and enforce ZDR>
# OPENROUTER_UPSTREAM_SLUG=<ONE reviewed exact endpoint, e.g. deepinfra/turbo; required to activate adapter>
# CLOUDFLARE_API_TOKEN=<server-only, Workers AI scope>
# CLOUDFLARE_ACCOUNT_ID=<32 hex characters, not a secret>
# NVIDIA_API_KEY=<server-only; hosted trial for synthetic prototyping only>
# NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
# NVIDIA_ALLOWED_HOSTS=<additional explicitly approved HTTPS NIM host, if contracted>
# OLLAMA_ENABLED=false                     # local loopback only, never Ollama Cloud
# OLLAMA_BASE_URL=http://127.0.0.1:11434   # unauthenticated local API; no public proxy

# Real user credentials, tokens, invitations and database URLs must not be sent in chat.
